# momsolar API + pipeline settings (prefix MOMSOLAR_). Copy to .env (git-ignored) and fill in.
# Read by the API (pydantic-settings) and by scripts/refresh_all.sh.

# Processed data: homes.json, ft_rates.csv and <home>/*.csv. Read by the API, written by
# the pipeline scripts and POST /refresh. Git-ignored; a fresh clone is seeded from sample_data/.
MOMSOLAR_DATA_DIR=frontend/public/data

# Raw inverter exports (used by scripts/refresh_all.sh and POST /refresh).
MOMSOLAR_SOLIS_RAW_DIR="/path/to/Solar Energy/MomHome"
MOMSOLAR_HUAWEI_RAW_DIR="/path/to/Solar Energy/Raw from Inverter report"
# The Google Sheet as .xlsx (File → Download): PEA Log, MEA Log and the Ft table. Optional.
MOMSOLAR_SHEET=

# SolisCloud API (MomHome), from SolisCloud → Account → Basic Settings → API Management.
# Secret: keep it only in .env. With these set, refresh_all.sh and POST /refresh also pull
# the last two days from the API (python -m momsolar.fetch_solis_api --since DATE backfills).
MOMSOLAR_SOLIS_KEY_ID=
MOMSOLAR_SOLIS_KEY_SECRET=

# Origins allowed to call the API (the Vite dev server by default).
MOMSOLAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://solar.localhost:8080,http://solar-dev.localhost:8080
