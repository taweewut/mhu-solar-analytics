# Dashboard + live data behind a secret link: the first visit to /?key=<SOLAR_WEB_KEY> stores a
# year-long cookie (so a TV bookmark keeps working), and anything without it gets 403.
# Plain HTTP inside Docker: HTTPS comes from the Cloudflare Tunnel in front.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	# `route` keeps these in the written order (Caddy would otherwise run the file handlers before
	# the 403): key link → no cookie → live data → the app.
	route {
		@setkey query key={$SOLAR_WEB_KEY}
		handle @setkey {
			header Set-Cookie "solar_key={$SOLAR_WEB_KEY}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax"
			redir * {path} 302
		}

		@nokey not header Cookie *solar_key={$SOLAR_WEB_KEY}*
		handle @nokey {
			respond "Forbidden" 403
		}

		# Live data from the poller's volume (never the copy baked into the build).
		handle /data/* {
			root * /srv
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			root * /srv/dist
			file_server
		}
	}
}
