# deploy/nas/.env on the NAS (git-ignored). Copy this and fill in.
MOMSOLAR_SOLIS_KEY_ID=
MOMSOLAR_SOLIS_KEY_SECRET=
MOMSOLAR_SOLIS_DAILY_BUDGET=180
# Long random string; the link to open once per device is https://<host>/?key=<this>
SOLAR_WEB_KEY=
# Signs guest links (scripts/guest_link.sh); a new value cancels every guest link.
SOLAR_GUEST_SECRET=
# The bills Google Sheet's ID (from its URL: /spreadsheets/d/<ID>/edit). The poller reads it
# hourly with pipeline/token.json, which needs the read-only Sheets permission
# (solar_pipeline: fetch_solar_report.py --reauth). Leave empty to skip bills.
MOMSOLAR_SHEET_ID=
# The Cloudflare Tunnel token is not needed here: the shared connector in
# /volume1/docker/cloudflared keeps it in its own .env.
