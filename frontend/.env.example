# Leave empty to read the static files in public/data (default, no server needed).
# Set to the momsolar FastAPI base URL to read the same data through the API instead:
#   uvicorn momsolar.api.app:app --reload --port 8020   →   http://solar-api.localhost:8080
# Vite only reads VITE_* at dev-server start — restart `npm run dev` after editing.
VITE_API_BASE_URL=

# Default for the Settings dialog's effective rate (฿/kWh). Each home's system cost comes
# from public/data/homes.json; each viewer can override both in the UI.
VITE_EFFECTIVE_RATE=4.34
